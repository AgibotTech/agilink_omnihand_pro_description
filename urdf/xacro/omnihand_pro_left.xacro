<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="omnihand">

<xacro:include filename="$(find omnihand_pro_description)/urdf/xacro/hand.xacro" />


<xacro:hand name="L" mirror="-1" mirror_mesh="True" >
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
</xacro:hand>

</robot>