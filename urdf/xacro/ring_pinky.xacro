<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ring" params="name mirror mirror_mesh *origin">
        <!-- ring  -->

        <link name="${name}_proximal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/ring_proximal.STL" />
                </geometry>
                <material name="black" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_proximal_com_x} ${ring_proximal_com_y*mirror} ${ring_proximal_com_z}" />
                <mass value="${ring_proximal_mass}" />
                <inertia
                    ixx="${ring_proximal_ixx}" ixy="${ring_proximal_ixy*mirror}"
                    ixz="${ring_proximal_ixz}"
                    iyy="${ring_proximal_iyy}" iyz="${ring_proximal_iyz*mirror}"
                    izz="${ring_proximal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0"
                    xyz="${ring_proximal_collision_x} ${ring_proximal_collision_y} ${ring_proximal_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_proximal_collision_r}"
                        length="${ring_proximal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_mcp_joint" type="revolute">
            <xacro:insert_block name="origin" />
            <parent link="hand_base_link" />
            <child link="${name}_proximal" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_mcp_torque_max}" velocity="${ring_mcp_velocity_max}"
                lower="${ring_mcp_position_min}" upper="${ring_mcp_position_max}" />
        </joint>

        <link name="${name}_middle">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/ring_middle.STL" />
                </geometry>
                <material name="black" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_middle_com_x} ${ring_middle_com_y*mirror} ${ring_middle_com_z}" />
                <mass value="${ring_proximal_mass}" />
                <inertia
                    ixx="${ring_middle_ixx}" ixy="${ring_middle_ixy*mirror}"
                    ixz="${ring_middle_ixz}"
                    iyy="${ring_middle_iyy}" iyz="${ring_middle_iyz*mirror}"
                    izz="${ring_middle_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0"
                    xyz="${ring_middle_collision_x} ${ring_middle_collision_y} ${ring_middle_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_middle_collision_r}"
                        length="${ring_middle_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_pip_joint" type="revolute">
            <origin xyz="${ring_pip_x} ${ring_pip_y} ${ring_pip_z}" rpy="0 0 0" />
            <parent link="${name}_proximal" />
            <child link="${name}_middle" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_pip_torque_max}" velocity="${ring_pip_velocity_max}"
                lower="${ring_pip_position_min}" upper="${ring_pip_position_max}" />
            <mimic
                joint="${name}_mcp_joint"
                multiplier="${ring_pip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_distal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/ring_distal.STL" />
                </geometry>
                <material name="black" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_distal_com_x} ${ring_distal_com_y*mirror} ${ring_distal_com_z}" />
                <mass value="${ring_distal_mass}" />
                <inertia
                    ixx="${ring_distal_ixx}" ixy="${ring_distal_ixy*mirror}"
                    ixz="${ring_distal_ixz}"
                    iyy="${ring_distal_iyy}" iyz="${ring_distal_iyz*mirror}"
                    izz="${ring_distal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0"
                    xyz="${ring_distal_collision_x} ${ring_distal_collision_y} ${ring_distal_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_distal_collision_r}"
                        length="${ring_distal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_dip_joint" type="revolute">
            <origin xyz=" ${ring_dip_x}  ${ring_dip_y} ${ring_dip_z}" rpy="0 0 0" />
            <parent link="${name}_middle" />
            <child link="${name}_distal" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_dip_torque_max}" velocity="${ring_dip_velocity_max}"
                lower="${ring_dip_position_min}" upper="${ring_dip_position_max}" />
            <mimic
                joint="${name}_mcp_joint"
                multiplier="${ring_dip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_distal_vertices_virtual_coordinates">
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <sphere radius="0.001" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_tip_joint" type="fixed">
            <origin xyz="${ring_tips_x} 0 ${ring_tips_z}" rpy="0 0 0" />
            <parent link="${name}_distal" />
            <child link="${name}_distal_vertices_virtual_coordinates" />
        </joint>
    </xacro:macro>
</robot>