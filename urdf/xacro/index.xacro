<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="index" params="name mirror mirror_mesh *origin">
        <!-- index  -->
        <link name="${name}_index_metacarpals">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/index_metacarpals.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/index_metacarpals.STL" />
                    </xacro:if>
                </geometry>
                <material name="metacarpals"/>
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${index_metacarpals_com_x} ${index_metacarpals_com_y*mirror} ${index_metacarpals_com_z}" />
                <mass value="${index_metacarpals_mass}" />
                <inertia
                    ixx="${index_metacarpals_ixx}" ixy="${index_metacarpals_ixy*mirror}"
                    ixz="${index_metacarpals_ixz}"
                    iyy="${index_metacarpals_iyy}" iyz="${index_metacarpals_iyz*mirror}" 
                    izz="${index_metacarpals_izz}" />
            </inertial>
        </link>

        <joint name="${name}_index_abad_joint" type="revolute">
            <origin xyz="${index_abad_x} ${index_abad_y*mirror} ${index_abad_z}" rpy="0 0 0" />
            <parent link="${name}_hand_base_link" />
            <child link="${name}_index_metacarpals" />
            <axis xyz="1 0 0" />

            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${index_abad_torque_max}" velocity="${index_abad_velocity_max}"
                    lower="${index_abad_position_max*mirror}"
                    upper="${index_abad_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${index_abad_torque_max}" velocity="${index_abad_velocity_max}"
                    lower="${index_abad_position_min}" upper="${index_abad_position_max}" />
            </xacro:if>
        </joint>

        <link name="${name}_index_proximal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/index_proximal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/index_proximal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${index_proximal_com_x} ${index_proximal_com_y*mirror} ${index_proximal_com_z}" />
                <mass value="${index_proximal_mass}" />
                <inertia
                    ixx="${index_proximal_ixx}" ixy="${index_proximal_ixy*mirror}" 
                    ixz="${index_proximal_ixz}" 
                    iyy="${index_proximal_iyy}" iyz="${index_proximal_iyz*mirror}" 
                    izz="${index_proximal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${index_proximal_collision_x} ${index_proximal_collision_y} ${index_proximal_collision_z}" />
                <geometry>
                    <cylinder radius="${index_proximal_collision_r}" length="${index_proximal_collision_l}" />
                </geometry>
            </collision>            
        </link>

        <joint name="${name}_index_mcp_joint" type="revolute">
            <origin xyz="${index_mcp_x} ${index_mcp_y} ${index_mcp_z}" rpy="0 0 0" />
            <parent link="${name}_index_metacarpals" />
            <child link="${name}_index_proximal" />
            <axis xyz="0 1 0" />
            <limit effort="${index_mcp_torque_max}" velocity="${index_mcp_velocity_max}"
                lower="${index_mcp_position_min}" upper="${index_mcp_position_max}" />
        </joint>

        <link name="${name}_index_middle">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/index_middle.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/index_middle.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${index_middle_com_x} ${index_middle_com_y*mirror} ${index_middle_com_z}" />
                <mass value="${index_proximal_mass}" />
                <inertia
                    ixx="${index_middle_ixx}" ixy="${index_middle_ixy*mirror}" 
                    ixz="${index_middle_ixz}"
                    iyy="${index_middle_iyy}" iyz="${index_middle_iyz*mirror}" 
                    izz="${index_middle_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${index_middle_collision_x} ${index_middle_collision_y} ${index_middle_collision_z}" />
                <geometry>
                    <cylinder radius="${index_middle_collision_r}" length="${index_middle_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_index_pip_joint" type="revolute">
            <origin xyz="${index_pip_x} ${index_pip_y} ${index_pip_z}" rpy="0 0 0" />
            <parent link="${name}_index_proximal" />
            <child link="${name}_index_middle" />
            <axis xyz="0 1 0" />
            <limit effort="${index_pip_torque_max}" velocity="${index_pip_velocity_max}"
                lower="${index_pip_position_min}" upper="${index_pip_position_max}" />
        </joint>

        <link name="${name}_index_distal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/index_distal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/index_distal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${index_distal_com_x} ${index_distal_com_y*mirror} ${index_distal_com_z}" />
                <mass value="${index_distal_mass}" />
                <inertia
                    ixx="${index_distal_ixx}" ixy="${index_distal_ixy*mirror}"
                    ixz="${index_distal_ixz}"
                    iyy="${index_distal_iyy}" iyz="${index_distal_iyz*mirror}"
                    izz="${index_distal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${index_distal_collision_x} ${index_distal_collision_y} ${index_distal_collision_z}" />
                <geometry>
                    <cylinder radius="${index_distal_collision_r}" length="${index_distal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_index_dip_joint" type="revolute">
            <origin xyz=" ${index_dip_x}  ${index_dip_y} ${index_dip_z}" rpy="0 0 0" />
            <parent link="${name}_index_middle" />
            <child link="${name}_index_distal" />
            <axis xyz="0 1 0" />
            <limit effort="${index_dip_torque_max}" velocity="${index_dip_velocity_max}"
                lower="${index_dip_position_min}" upper="${index_dip_position_max}" />
            <mimic
                joint="${name}_index_pip_joint"
                multiplier="${index_dip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_index_distal_vertices_virtual_coordinates">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/index_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/index_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                </geometry>
                <material name="tips"/>
            </visual>
        </link>

        <joint name="${name}_index_tip" type="fixed">
            <origin xyz="${index_tips_x} 0 ${index_tips_z}" rpy="0 0 0" />
            <parent link="${name}_index_distal" />
            <child link="${name}_index_distal_vertices_virtual_coordinates" />
        </joint>

    </xacro:macro>
</robot>