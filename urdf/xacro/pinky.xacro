<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="pinky" params="name mirror mirror_mesh *origin">
        <!-- pinky  -->

        <link name="${name}_pinky_proximal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/pinky_proximal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/pinky_proximal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${pinky_proximal_com_x} ${pinky_proximal_com_y*mirror} ${pinky_proximal_com_z}" />
                <mass value="${pinky_proximal_mass}" />
                <inertia
                    ixx="${pinky_proximal_ixx}" ixy="${pinky_proximal_ixy*mirror}" 
                    ixz="${pinky_proximal_ixz}"
                    iyy="${pinky_proximal_iyy}" iyz="${pinky_proximal_iyz*mirror}" 
                    izz="${pinky_proximal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${pinky_proximal_collision_x} ${pinky_proximal_collision_y} ${pinky_proximal_collision_z}" />
                <geometry>
                    <cylinder radius="${pinky_proximal_collision_r}" length="${pinky_proximal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_pinky_mcp_joint" type="revolute">
            <origin xyz="${pinky_mcp_x} ${pinky_mcp_y*mirror} ${pinky_mcp_z}" rpy="0 0 0" />
            <parent link="hand_base_link" />
            <child link="${name}_pinky_proximal" />
            <axis xyz="0 1 0" />
            <limit effort="${pinky_mcp_torque_max}" velocity="${pinky_mcp_velocity_max}"
                lower="${pinky_mcp_position_min}" upper="${pinky_mcp_position_max}" />
        </joint>

        <link name="${name}_pinky_middle">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/pinky_middle.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/pinky_middle.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${pinky_middle_com_x} ${pinky_middle_com_y*mirror} ${pinky_middle_com_z}" />
                <mass value="${pinky_proximal_mass}" />
                <inertia
                    ixx="${pinky_middle_ixx}" ixy="${pinky_middle_ixy*mirror}" 
                    ixz="${pinky_middle_ixz}"
                    iyy="${pinky_middle_iyy}" iyz="${pinky_middle_iyz*mirror}" 
                    izz="${pinky_middle_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${pinky_middle_collision_x} ${pinky_middle_collision_y} ${pinky_middle_collision_z}" />
                <geometry>
                    <cylinder radius="${pinky_middle_collision_r}" length="${pinky_middle_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_pinky_pip_joint" type="revolute">
            <origin xyz="${pinky_pip_x} ${pinky_pip_y} ${pinky_pip_z}" rpy="0 0 0" />
            <parent link="${name}_pinky_proximal" />
            <child link="${name}_pinky_middle" />
            <axis xyz="0 1 0" />
            <limit effort="${pinky_pip_torque_max}" velocity="${pinky_pip_velocity_max}"
                lower="${pinky_pip_position_min}" upper="${pinky_pip_position_max}" />
            <mimic
                joint="${name}_pinky_mcp_joint"
                multiplier="${pinky_pip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_pinky_distal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/pinky_distal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/pinky_distal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${pinky_distal_com_x} ${pinky_distal_com_y*mirror} ${pinky_distal_com_z}" />
                <mass value="${pinky_distal_mass}" />
                <inertia
                    ixx="${pinky_distal_ixx}" ixy="${pinky_distal_ixy*mirror}"
                    ixz="${pinky_distal_ixz}"
                    iyy="${pinky_distal_iyy}" iyz="${pinky_distal_iyz*mirror}"
                    izz="${pinky_distal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="${pinky_distal_collision_x} ${pinky_distal_collision_y} ${pinky_distal_collision_z}" />
                <geometry>
                    <cylinder radius="${pinky_distal_collision_r}" length="${pinky_distal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_pinky_dip_joint" type="revolute">
            <origin xyz=" ${pinky_dip_x}  ${pinky_dip_y} ${pinky_dip_z}" rpy="0 0 0" />
            <parent link="${name}_pinky_middle" />
            <child link="${name}_pinky_distal" />
            <axis xyz="0 1 0" />
            <limit effort="${pinky_dip_torque_max}" velocity="${pinky_dip_velocity_max}"
                lower="${pinky_dip_position_min}" upper="${pinky_dip_position_max}" />
            <mimic
                joint="${name}_pinky_mcp_joint"
                multiplier="${pinky_dip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_pinky_distal_vertices_virtual_coordinates">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t2_left_meshes/pinky_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t2_right_meshes/pinky_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                </geometry>
                <material name="tips" />
            </visual>
        </link>

        <joint name="${name}_pinky_tip_joint" type="fixed">
            <origin xyz="${pinky_tips_x} 0 ${pinky_tips_z}" rpy="0 0 0" />
            <parent link="${name}_pinky_distal" />
            <child link="${name}_pinky_distal_vertices_virtual_coordinates" />
        </joint>
    </xacro:macro>
</robot>