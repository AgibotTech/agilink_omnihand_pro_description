<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ring" params="name mirror mirror_mesh *origin">
        <!-- ring  -->

        <link name="${name}_ring_proximal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t1_left_meshes/ring_proximal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t1_right_meshes/ring_proximal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_proximal_com_x} ${ring_proximal_com_y} ${ring_proximal_com_z}" />
                <mass value="${ring_proximal_mass}" />
                <inertia
                    ixx="${ring_proximal_ixx}" ixy="${ring_proximal_ixy}" ixz="${ring_proximal_ixz}"
                    iyy="${ring_proximal_iyy}" iyz="${ring_proximal_iyz}" izz="${ring_proximal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 ${ring_proximal_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_proximal_collision_r}" length="${ring_proximal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_ring_mcp_joint" type="revolute">
            <origin xyz="${ring_mcp_x} ${ring_mcp_y*mirror} ${ring_mcp_z}" rpy="0 0 0" />
            <parent link="${name}_hand_base_link" />
            <child link="${name}_ring_proximal" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_mcp_torque_max}" velocity="${ring_mcp_velocity_max}"
                lower="${ring_mcp_position_min}" upper="${ring_mcp_position_max}" />
        </joint>

        <link name="${name}_ring_middle">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t1_left_meshes/ring_middle.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t1_right_meshes/ring_middle.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_middle_com_x} ${ring_middle_com_y} ${ring_middle_com_z}" />
                <mass value="${ring_proximal_mass}" />
                <inertia
                    ixx="${ring_middle_ixx}" ixy="${ring_middle_ixy}" ixz="${ring_middle_ixz}"
                    iyy="${ring_middle_iyy}" iyz="${ring_middle_iyz}" izz="${ring_middle_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 ${ring_middle_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_middle_collision_r}" length="${ring_middle_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_ring_pip_joint" type="revolute">
            <origin xyz="${ring_pip_x} ${ring_pip_y} ${ring_pip_z}" rpy="0 0 0" />
            <parent link="${name}_ring_proximal" />
            <child link="${name}_ring_middle" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_pip_torque_max}" velocity="${ring_pip_velocity_max}"
                lower="${ring_pip_position_min}" upper="${ring_pip_position_max}" />
            <mimic
                joint="${name}_ring_mcp_joint"
                multiplier="${ring_pip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_ring_distal">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t1_left_meshes/ring_distal.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t1_right_meshes/ring_distal.STL" />
                    </xacro:if>
                </geometry>
                <material name="white" />
            </visual>
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${ring_distal_com_x} ${ring_distal_com_y} ${ring_distal_com_z}" />
                <mass value="${ring_distal_mass}" />
                <inertia
                    ixx="${ring_distal_ixx}" ixy="${ring_distal_ixy}"
                    ixz="${ring_distal_ixz}"
                    iyy="${ring_distal_iyy}" iyz="${ring_distal_iyz}"
                    izz="${ring_distal_izz}" />
            </inertial>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 ${ring_distal_collision_z}" />
                <geometry>
                    <cylinder radius="${ring_distal_collision_r}" length="${ring_distal_collision_l}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_ring_dip_joint" type="revolute">
            <origin xyz=" ${ring_dip_x}  ${ring_dip_y} ${ring_dip_z}" rpy="0 0 0" />
            <parent link="${name}_ring_middle" />
            <child link="${name}_ring_distal" />
            <axis xyz="0 1 0" />
            <limit effort="${ring_dip_torque_max}" velocity="${ring_dip_velocity_max}"
                lower="${ring_dip_position_min}" upper="${ring_dip_position_max}" />
            <mimic
                joint="${name}_ring_mcp_joint"
                multiplier="${ring_dip_multiplier}"
                offset="0" />
        </joint>

        <link name="${name}_ring_distal_vertices_virtual_coordinates">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/o12_t1_left_meshes/ring_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/o12_t1_right_meshes/ring_distal_vertices_virtual_coordinates.STL" />
                    </xacro:if>
                </geometry>
                <material name="tips" />
            </visual>
        </link>

        <joint name="${name}_ring_tip_joint" type="fixed">
            <origin xyz="${ring_tips_x} 0 ${ring_tips_z}" rpy="0 0 0" />
            <parent link="${name}_ring_distal" />
            <child link="${name}_ring_distal_vertices_virtual_coordinates" />
        </joint>
    </xacro:macro>
</robot>